{
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {
  },
  "ruff": {},
  "toml": {},
  "yaml": {},
  "excludes": [
    "**/ios/Runner/",
    "**/macos/Runner/",
    "**/.dart_tool/",
    // 機械生成の検索 Index（embedding vector を含む。pretty 化するとファイルサイズが
    // 数倍に膨らむため整形対象外にする。スクリプトが minified JSON で書き出す前提）
    ".claude/doc-advisor/index/**",
    ".claude/doc-db/index/**"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/ruff@0.11.3",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
